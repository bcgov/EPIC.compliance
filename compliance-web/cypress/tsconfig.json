{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "target": "es6",
    "lib": ["es6", "dom"],
    "types": ["cypress", "node"],
    "jsx": "react-jsx",
    "baseUrl": "../",
    "paths": {
      "@/*": ["src/*"]
    },
    "esModuleInterop": true
  },
  "include": [
    "../src/**/*",
    "**/*.ts",
    "**/*.tsx"
  ]
}
