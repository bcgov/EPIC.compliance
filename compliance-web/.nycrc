{
  "all": true,
  "check-coverage": true,
  "reporter": ["lcov", "clover", "json", "json-summary", "text-summary"],
  "lines": 25, 
  "functions": 25,
  "branches": 25,
  "statements": 25,
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "**/*.d.ts",
    "**/*.test.ts",
    "**/*.cy.ts",
    "cypress/**/*",
    "coverage/**/*"
  ]
}
